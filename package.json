{
  "name": "daniel-magic-english-castle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Daniel's Magic English Castle - a listening-first English adventure game for young Hebrew-speaking beginners",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.json",
    "start:server": "node server/dist/server/server.js",
    "test": "node scripts/run-selftest.mjs",
    "test:device": "npm run build && node scripts/check-build.mjs && node scripts/run-devicetest.mjs",
    "check:build": "node scripts/check-build.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/three": "^0.180.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
